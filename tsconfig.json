{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@ui/*": [
        "./submodules/ui/components/*"
      ],
      "@ui": [
        "./submodules/ui/components/index.js"
      ],
      "@features/*": [
        "./submodules/features/*"
      ],
      "@features": [
        "./submodules/features/index.js"
      ]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx", "global.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
